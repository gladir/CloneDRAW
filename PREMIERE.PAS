 X4EAudBitrate := 0;
 AudName := 'PCM';
 Case X4EAudKind Of
  1: AudName := 'AAC-LC';
  3: AudName := 'MP2';
  4: AudName := 'ALAC';
 End;
 F0 := 0;
 F1 := SeqEnd;
 If P.InM >= 0 Then F0 := P.InM;
 If (P.OutM >= 0) And (P.OutM > F0) Then F1 := Min(F1, P.OutM);
 NFr := F1 - F0;
 If NFr < 1 Then Exit;
 If NFr > 20000 Then Begin

 I: Integer;
Begin
 FillChar(P, SizeOf(P), 0);
 P.Name := 'Séquence 01';
 P.Fps := 25;
 P.NV := 3;
 P.NA := 3;
 CurBin := 0;
 If TrueMode Then Begin
  VW := 640;
  VH := 360;
 End Else Begin
  VW := 284;
  VH := 160;
 End;
 P.InM := -1;
 P.OutM := -1;
 FreeHistory;
 Playhead := 0;
 ScrollF := 0;
 PPS := 25;
 SrcMed := -1;
 SrcPos := 0;
 SrcIn := -1;
 SrcOut := -1;
 ProjSel := -1;
 ProjScroll := 0;
 MarkSel := -1;
 CtlScroll := 0;

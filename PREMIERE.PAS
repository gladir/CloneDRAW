{ Imbrique la selection : rend l'image composee des seuls clips selectionnes dans un nouveau
  media video (cache) et remplace ces clips par un seul clip. }
Procedure NestSelection;
Var
 I, T, Lo, K, M: Integer;
 S0, S1, F: LongInt;
 Pix: PBigBytes;
 X, Y: Integer;
 Nf, Fps100: LongInt;
 Cache: String;
 Any: Boolean;
Begin
 S0 := 999999999;
 S1 := 0;
 Lo := 99;
 Any := False;
 For I := 0 To P.NC - 1 Do
  If P.Clips[I].Sel And IsVideoTrack(P.Clips[I].Trk) Then Begin
   Any := True;
   S0 := Min(S0, P.Clips[I].Start);
   S1 := Max(S1, ClipEnd(I));
   Lo := Min(Lo, P.Clips[I].Trk);
  End;
 If Not Any Then Begin
  Msg('Sélectionnez des clips vidéo à imbriquer');
  Exit;
 End;
 If (S1 - S0 > P.Fps * 120) Or (P.NM >= MAXMEDIA) Then Begin
  Msg('Sélection trop longue (120 s max) ou projet plein');
  Exit;
 End;
 Cache := 'PN' + HexN(Ticks And $FFFFFF, 6) + '.PVC';
 If Not ConfBegin(Cache, False, 600, 'Imbrication de la sélection', False) Then Exit;
 ConfSetFps(P.Fps * 100);
 GetMem(Pix, LongInt(VW) * VH * 3);
 OnlySel := True;
 F := S0;
 While (F < S1) And (Not CnCancel) Do Begin
  BuildLayers(F);
  For Y := 0 To VH - 1 Do
   For X := 0 To VW - 1 Do Begin
    If NLay = 0 Then Begin
     AR := 0; AG := 0; AB := 0;
    End Else Compose(X, Y);
    Pix^[(Y * VW + X) * 3] := AR;
    Pix^[(Y * VW + X) * 3 + 1] := AG;
    Pix^[(Y * VW + X) * 3 + 2] := AB;
   End;
  If Not ConfEmit(VW, VH, Pix) Then Break;
  Inc(F);
 End;
 OnlySel := False;
 FreeMem(Pix, LongInt(VW) * VH * 3);
 ConfEnd(Nf, Fps100);
 If Nf < 1 Then Begin
  Msg('Imbrication impossible');
  Exit;
 End;
 PushUndo;
 M := AddMedia('Imbriqué ' + HexN(Ticks And $FFF, 3), MK_VIDEO, Nf, 30, '', '');
 If M < 0 Then Begin
  DropLastUndo;
  Exit;
 End;
 P.Media[M].Cache := Cache;
 P.Media[M].NF := Nf;
 P.Media[M].Fps100 := Integer(Fps100);
 P.Media[M].CW := Integer(CnCW);
 P.Media[M].CH := Integer(CnCH);
 RecalcMediaDurs;
 For I := P.NC - 1 Downto 0 Do
  If P.Clips[I].Sel And IsVideoTrack(P.Clips[I].Trk) Then DelClip(I);
 K := PlaceClip(Lo, M, S0, 0, Nf);
 ClearSel;
 If K >= 0 Then P.Clips[K].Sel := True;
 NeedAll := True;
 Msg('Sélection imbriquée dans un clip rendu');
End;

Procedure SetWorkspace(W: Integer);
Begin
 WorkSp := W;
 Case W Of
  0: Begin TabA := 0; TabC := 0; End;
  1: Begin TabA := 0; TabC := 1; End;
  2: Begin TabA := 1; TabC := 0; End;
  3: Begin TabA := 1; TabC := 1; End;
 Else Begin TabA := 1; TabC := 2; End;
 End;
 NeedAll := True;
End;

Procedure MarkIO(IsIn: Boolean);
Begin
 If FocusSrc And (TabA = 0) And (SrcMed >= 0) Then Begin
  If IsIn Then Begin
   SrcIn := SrcPos;
   If (SrcOut >= 0) And (SrcOut <= SrcIn) Then SrcOut := -1;
  End Else Begin
   SrcOut := SrcPos;
   If (SrcIn >= 0) And (SrcIn >= SrcOut) Then SrcIn := -1;
  End;
  NeedSrc := True;
 End Else Begin
  If IsIn Then Begin
   P.InM := Playhead;
   If (P.OutM >= 0) And (P.OutM <= P.InM) Then P.OutM := -1;
  End Else Begin
   P.OutM := Playhead;
   If (P.InM >= 0) And (P.InM >= P.OutM) Then P.InM := -1;
  End;
  NeedProg := True;
  NeedTL := True;
 End;
End;

Procedure RenameSel;
Var
 I: Integer;
 S: String;
Begin
 I := FirstSel;
 If I < 0 Then Exit;
 S := P.Clips[I].Name;
 If Not InputBox('Renommer le clip', 'Nouveau nom :', S, 20) Then Exit;
 If S = '' Then Exit;
 PushUndo;
 P.Clips[I].Name := S;
 NeedTL := True;
 NeedA := True;
End;

Procedure EditTitle;
Var
 I, M: Integer;
 S: String;
Begin
 I := FirstSel;
 If I < 0 Then Exit;
 M := P.Clips[I].Med;
 If P.Media[M].Kind <> MK_TITLE Then Exit;
 PushUndo;
 If Not TitleDialog(P.Media[M]) Then Begin
  DropLastUndo;
  Exit;
 End;
 NeedAll := True;
End;

Procedure ToggleSelClips(Bit: Integer);
Var
 I: Integer;
Begin
 If SelCount = 0 Then Exit;
 PushUndo;
 For I := 0 To P.NC - 1 Do
  If P.Clips[I].Sel Then P.Clips[I].Fl := P.Clips[I].Fl Xor Bit;
 NeedTL := True;
 NeedProg := True;
 NeedA := True;
End;


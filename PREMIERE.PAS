Function CtlGet(C: Integer; Id: Integer): Integer;
Var
 V: Integer;
 KP: Integer;
Begin
 CtlGet := 0;
 If (C < 0) Or (C >= P.NC) Then Exit;
 With P.Clips[C] Do Begin
  Case Id Of
   1: V := PosX;
   2: V := PosY;
   3: V := Scale;
   4: V := Opac;
   5: V := Br;
   6: V := Co;
   7: V := Sa;
   8: V := Mos;
   9: V := Vol;
   10: V := TInL;
   11: V := TOutL;
   12: V := Rot;
   13: V := Pan;
   14: V := CropL;
   15: V := CropT;
   16: V := CropR;
   17: V := CropB;
   18: V := Blur;
   19: V := Sharp;
   20: V := Ord((Fl And CF_MIRH) <> 0);
   21: V := Ord((Fl And CF_MIRV) <> 0);
   22: V := Ord((Fl And CF_INV) <> 0);
   23: V := Ord(Mute);
   24: V := Ord((Fl And CF_OFF) <> 0);
   25: V := Blend;
   26: V := KeyOn;
   27: V := KeySim;
   28: V := KeySmo;
   30: V := TIn;
   31: V := TOut;
   32: V := MaskK;
   33: V := MaskX;
   34: V := MaskY;
   35: V := MaskW;
   36: V := MaskH;
   37: V := MaskF;
   38: V := Ord((Fl And CF_MASKINV) <> 0);
   39: V := LutIdx;
   45: V := EqL;
   46: V := EqM;
   47: V := EqH;
   48: V := Comp;
   49: V := Rev;
   50: V := Gate;
  Else V := 0;
  End;
  KP := CtlKP(Id);
  If KP >= 0 Then V := Integer(KfEval(P.Clips[C], KP, Playhead - Start, V));
 End;
 CtlGet := V;
End;

Procedure CtlSet(C: Integer; Id, V: Integer);
Var
 Bit, KP: Integer;
 Tl: LongInt;
Begin
 If (C < 0) Or (C >= P.NC) Then Exit;
 KP := CtlKP(Id);
 If (KP >= 0) And KfHas(P.Clips[C], KP) Then Begin
  Tl := Clamp(Playhead - P.Clips[C].Start, 0, Max(0, P.Clips[C].Dur - 1));
  KfSet(P.Clips[C], KP, Tl, V, DefInterp);
  Exit;
 End;
 With P.Clips[C] Do
  Case Id Of
   1: PosX := V;
   2: PosY := V;
   3: Scale := V;
   4: Opac := V;
   5: Br := V;
   6: Co := V;
   7: Sa := V;
   8: Mos := V;
   9: Vol := V;
   10: TInL := V;
   11: TOutL := V;
   12: Rot := V;
   13: Pan := V;
   14: CropL := V;
   15: CropT := V;
   16: CropR := V;
   17: CropB := V;
   18: Blur := V;
   19: Sharp := V;
   20, 21, 22, 24, 38: Begin
    Case Id Of
     20: Bit := CF_MIRH;
     21: Bit := CF_MIRV;
     22: Bit := CF_INV;
     38: Bit := CF_MASKINV;
    Else Bit := CF_OFF;
    End;
    If V <> 0 Then Fl := Fl Or Bit Else Fl := Fl And (Not Bit);
   End;
   23: Mute := V <> 0;
   25: Blend := V;
   26: KeyOn := V;
   27: KeySim := V;
   28: KeySmo := V;
   30: TIn := V;
   31: TOut := V;
   32: MaskK := V;
   33: MaskX := V;
   34: MaskY := V;
   35: MaskW := V;
   36: MaskH := V;
   37: MaskF := V;
   39: LutIdx := V;
   45: EqL := V;
   46: EqM := V;
   47: EqH := V;
   48: Comp := V;
   49: Rev := V;
   50: Gate := V;
  End;
End;

{ Active/desactive l'animation d'un parametre : premiere cle a la tete de lecture,
  puis ajoute ou retire la cle a cet instant ; desactive quand la derniere cle disparait. }
Procedure KfToggleKey(C: Integer; Id: Integer; Off: Boolean);
Var
 KP, I: Integer;
 Tl, V: LongInt;
Begin
 KP := CtlKP(Id);
 If (KP < 0) Or (C < 0) Or (C >= P.NC) Then Exit;
 Tl := Clamp(Playhead - P.Clips[C].Start, 0, Max(0, P.Clips[C].Dur - 1));
 V := CtlGet(C, Id);
 If Off Then Begin
  P.Clips[C].Kn[KP] := 0;
  CtlSet(C, Id, Integer(V));
  Exit;
 End;
 If Not KfHas(P.Clips[C], KP) Then Begin
  KfSet(P.Clips[C], KP, Tl, V, DefInterp);
  Exit;
 End;
 I := KfFind(P.Clips[C], KP, Tl);
 If I >= 0 Then Begin
  If P.Clips[C].Kn[KP] = 1 Then Begin
   P.Clips[C].Kn[KP] := 0;
   CtlSet(C, Id, Integer(V));
  End Else KfDel(P.Clips[C], KP, I);
 End Else KfSet(P.Clips[C], KP, Tl, V, DefInterp);
End;

